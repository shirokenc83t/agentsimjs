{
  "name": "agentsimjs-ng",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @agentsim/lab dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run --project node --project dom --project xengine --project browser",
    "test:determinism": "vitest run --project determinism",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots=changed",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/ && node tools/lint/no-literal-colours.mjs",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.bench.json",
    "format": "prettier --write .",
    "bench": "node tools/bench/run.mjs",
    "ci:local": "pnpm install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "bench:gpu": "node tools/bench/run.mjs --gpu",
    "test:e2e:gpu": "node tools/test/e2e-gpu.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tinybench": "6.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
